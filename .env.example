# Configuration NextAuth.js
NEXTAUTH_SECRET=changeme_une_valeur_secrete_complexe_ici
NEXTAUTH_URL=http://localhost:3000

# Configuration base de données
# PostgreSQL. En local : une base PostgreSQL. Sur Supabase :
#   DATABASE_URL = pooler « Transaction » (port 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = connexion directe (port 5432), utilisée par les migrations
DATABASE_URL="postgresql://stand:motdepasse@localhost:5432/stand"
DIRECT_URL="postgresql://stand:motdepasse@localhost:5432/stand"

# Compte DG créé au déploiement (scripts/bootstrap-accounts.ts)
DG_EMAIL=
DG_PASSWORD=


# Compte organisateur
ORGANIZER_EMAIL=stand@ansut.local
ORGANIZER_PASSWORD=a_definir
NEXT_PUBLIC_ORGANIZER_EMAIL=admin@ansut.local
# Agents IA du stand (facultatif : sans clé, chaque agent passe en « mode sans IA », signalé à l'écran)
ANTHROPIC_API_KEY=
# Modèle utilisé (défaut : claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Plafond d'appels IA par heure (au-delà : mode sans IA)
AI_MAX_CALLS_PER_HOUR=400
